{
  "name": "graduate-project-ticketpulse-monorepo",
  "version": "1.0.0",
  "description": "TicketPulse Monorepo",
  "private": true,
  "scripts": {
    "prepare": "git submodule update --init --recursive",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "turbo run format && prettier --write \"*.{json,md}\" \"scripts/**/*.{js,cjs}\"",
    "format:check": "turbo run format:check && prettier --check \"*.{json,md}\" \"scripts/**/*.{js,cjs}\"",
    "clean": "turbo run clean",
    "clean:full": "turbo run clean --continue && turbo clean && node scripts/clean/index.cjs",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d",
    "deploy:local": "turbo run deploy:local"
  },
  "packageManager": "pnpm@10.33.2",
  "devDependencies": {
    "prettier": "^3.2.5",
    "rimraf": "^6.0.1",
    "turbo": "^2.9.6"
  },
  "pnpm": {
    "overrides": {
      "qrcode": "1.5.1"
    }
  }
}
