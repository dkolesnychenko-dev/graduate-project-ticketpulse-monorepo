{
  "name": "@ticketpulse/e2e",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint tests/ --ext .ts",
    "format": "prettier --write \"tests/**/*.ts\"",
    "format:check": "prettier --check \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf .vitest-results",
    "seed": "vite-node scripts/seed.ts",
    "load-test": "vite-node scripts/loadTest.ts"
  },
  "devDependencies": {
    "@ticketpulse/ipfs": "workspace:*",
    "@types/node": "^20.11.24",
    "eslint": "^8.57.0",
    "eslint-config-custom": "workspace:*",
    "graphql-request": "^6.1.0",
    "prettier": "^3.2.5",
    "rimraf": "^6.0.1",
    "tsx": "^4.22.0",
    "typescript": "^5.0.0",
    "viem": "^2.48.11",
    "vite-node": "^6.0.0",
    "vitest": "^1.6.1"
  }
}
