# ═══════════════════════════════════════════════════════════════════
# @ticketpulse/contracts — Environment Variables
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env and adjust values as needed.
# ═══════════════════════════════════════════════════════════════════

# ─── Local Development (Anvil Default Account 0) ───────────────────
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ─── Testnet / Mainnet Deployment (Base Network) ───────────────────
# RPC URLs (Get from Alchemy, Infura, etc.)
RPC_URL_BASE_SEPOLIA=https://base-sepolia.g.alchemy.com/v2/YOUR_API_KEY
RPC_URL_BASE=https://base-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Deployer Private Key for Public Networks (DO NOT USE REAL MONEY ACCOUNT FOR TESTNET)
# PRIVATE_KEY=0x...

# ─── Contract Verification (Block Explorers) ───────────────────────
BASESCAN_API_KEY=your_basescan_api_key

# ─── Metadata & Links ──────────────────────────────────────────────
# Global base URL for ticket external links (e.g., https://ticketpulse.app/event/)
BASE_EXTERNAL_URL=https://ticketpulse.app/event/
