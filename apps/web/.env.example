# ════════════════════════════════════════════════════════════════════════════
# @ticketpulse/web — Environment Variables
# ════════════════════════════════════════════════════════════════════════════
# Copy this file to `.env.local` and edit for your scenario.
#
# Two kinds of variables:
#   • NEXT_PUBLIC_*   → bundled into the client. NEVER put secrets here.
#   • (no prefix)     → server-only. Read inside Edge / API routes.
#
# Every variable is validated with Zod at module load — typos fail fast
# with an aggregated error message pointing at the offending field.
#
# ── Quick start ─────────────────────────────────────────────────────────────
#   • Local dev (Anvil + Kubo + zero RPC keys) → use SECTION A (default).
#   • Base Sepolia / Mainnet deploy            → switch to SECTION B.
# ════════════════════════════════════════════════════════════════════════════


# ════════════════════════════════════════════════════════════════════════════
# SECTION A — LOCAL DEVELOPMENT (no API keys required)
# ════════════════════════════════════════════════════════════════════════════
# Prerequisites (from monorepo root):
#   1.  pnpm infra:up                                              # Docker: Postgres + Graph Node + Kubo
#   2.  anvil                                                      # Local blockchain (terminal #2)
#   3.  pnpm --filter @ticketpulse/contracts run deploy:local      # Deploy factory to Anvil
#   4.  pnpm --filter @ticketpulse/subgraph run create:local       # Create local subgraph (one-time)
#   5.  pnpm --filter @ticketpulse/subgraph run deploy:local       # Deploy subgraph
# Anvil's deterministic addresses guarantee the factory always lands at the
# constant below, so no copy-paste between terminals is needed.

# ─── Active chain ─────────────────────────────────────────────────────────
# 31337 = Anvil (Foundry default)
NEXT_PUBLIC_CHAIN_ID=31337

# ─── Deployed TicketPulseFactory address ──────────────────────────────────
# Deterministic for the first Anvil account, second contract deployed.
# Matches `packages/subgraph/networks.local.json`. Do NOT change unless you
# add other Foundry transactions before `Deploy.s.sol`.
NEXT_PUBLIC_FACTORY_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512

# ─── WalletConnect Cloud project id ───────────────────────────────────────
# Required even for local dev: RainbowKit's connectors fail to mount without
# one. Free tier — sign up at https://cloud.walletconnect.com (~30 s).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=replace_with_walletconnect_project_id

# ─── Local subgraph endpoint ──────────────────────────────────────────────
# Spun up by `pnpm infra:up` + `pnpm --filter @ticketpulse/subgraph deploy:local`.
NEXT_PUBLIC_SUBGRAPH_URL=http://localhost:8000/subgraphs/name/ticketpulse/subgraph

# ─── Local IPFS (Kubo, started by `pnpm infra:up`) ────────────────────────
# The IPFS upload route auto-detects "kubo" mode when PINATA_JWT is empty.
NEXT_PUBLIC_IPFS_GATEWAY_URL=http://127.0.0.1:8080

# ─── Chainlink mock ───────────────────────────────────────────────────────
# Anvil has no Chainlink contracts, so the `/api/chainlink` route returns
# this constant as the ETH→EUR rate. Adjust to test different values, or
# comment out to make the EUR column disappear gracefully.
MOCK_CHAINLINK_EUR_RATE=2800

# ─── External link base (optional) ────────────────────────────────────────
# Used in NFT metadata's `external_url` so wallets can deep-link back to
# the site. Safe to omit in local dev.
# NEXT_PUBLIC_BASE_EXTERNAL_URL=http://localhost:3000/events/


# ════════════════════════════════════════════════════════════════════════════
# SECTION B — PRODUCTION / STAGING (Base Sepolia or Base Mainnet)
# ════════════════════════════════════════════════════════════════════════════
# Uncomment + fill the block below and comment out SECTION A when deploying
# to Vercel (or running locally against The Graph Studio + Pinata).

# ─── Active chain ─────────────────────────────────────────────────────────
# 84532 = Base Sepolia (staging) │ 8453 = Base Mainnet (production)
# NEXT_PUBLIC_CHAIN_ID=84532

# ─── Deployed factory ─────────────────────────────────────────────────────
# Output of `pnpm --filter @ticketpulse/contracts run deploy:base-sepolia`
# (or `deploy:base` for mainnet). The deployer prints the address; you can
# also grab it from
#   packages/contracts/broadcast/Deploy.s.sol/<chainId>/run-latest.json.
# NEXT_PUBLIC_FACTORY_ADDRESS=0x...

# ─── WalletConnect ────────────────────────────────────────────────────────
# Same project id is fine across environments.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=replace_with_walletconnect_project_id

# ─── Subgraph Studio endpoint ─────────────────────────────────────────────
# Get the Query URL from the Studio dashboard after running:
#   pnpm --filter @ticketpulse/subgraph run deploy:studio:sepolia
# (or `:mainnet`). Public endpoints work without auth but are rate-limited.
# NEXT_PUBLIC_SUBGRAPH_URL=https://api.studio.thegraph.com/query/<subgraph-id>/ticketpulse-sepolia/version/latest

# Optional: gated query API key from The Graph Studio. Setting this enables
# higher rate limits + adds the `Authorization: Bearer …` header on the
# server-side `/api/graphql` proxy. Never reaches the client bundle.
# GRAPH_API_KEY=

# ─── Pinata: server-side uploads + dedicated read gateway ────────────────
# Required for production. Get the JWT from
#   https://app.pinata.cloud/developers/api-keys
# (free tier: 1 GB storage + 100 GB bandwidth/month).
# The gateway is auto-provisioned in the Pinata dashboard — copy the bare
# hostname (no protocol prefix).
# PINATA_JWT=eyJhbGciOiJIUzI1NiIsIn...
# PINATA_GATEWAY=your-id.mypinata.cloud

# ─── Optional: Infura dedicated IPFS gateway (read fallback) ──────────────
# The `@ticketpulse/ipfs` view-aggregator tries gateways in this order:
#   1. Your Pinata dedicated gateway (above)
#   2. https://ipfs.io (free public gateway — always tried)
#   3. INFURA_GATEWAY_URL (this var — when set)
# Configure only if you already have an Infura IPFS project — it's a paid
# fallback that helps when Pinata is rate-limited.
# INFURA_GATEWAY_URL=https://<your-project>.infura-ipfs.io

# ─── Public IPFS gateway shown in client bundles ──────────────────────────
# Used for `<Image src>` rendering and the client-side `cidToGatewayUrl`
# helpers. Default of `https://ipfs.io` is fine for almost everyone; swap
# in your own gateway if you want users to hit your Pinata domain directly.
# NEXT_PUBLIC_IPFS_GATEWAY_URL=https://ipfs.io

# ─── Server-side RPC for Chainlink reads ──────────────────────────────────
# Required for the `/api/chainlink` route in production. Pick ONE provider
# below — any works. Free tiers are enough for thesis-scale traffic.
# The client never sees this URL.
#
#   • Alchemy        https://dashboard.alchemy.com               ← 300M CU / month
#       SERVER_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY
#       (mainnet:    https://base-mainnet.g.alchemy.com/v2/YOUR_KEY)
#
#   • Infura         https://app.infura.io                       ← 100k req/day
#       SERVER_RPC_URL=https://base-sepolia.infura.io/v3/YOUR_PROJECT_ID
#       (mainnet:    https://base-mainnet.infura.io/v3/YOUR_PROJECT_ID)
#
#   • QuickNode      https://www.quicknode.com                   ← free tier with rate limits
#       SERVER_RPC_URL=https://<endpoint>.base-sepolia.quiknode.pro/<token>/
# SERVER_RPC_URL=

# ─── Override the Chainlink ETH/EUR aggregator address ────────────────────
# Optional. Use this when running against a chain whose default aggregator
# (in `packages/sdk/src/services/chainlink.ts`) is missing or stale.
# Full list: https://docs.chain.link/data-feeds/price-feeds/addresses
# NEXT_PUBLIC_CHAINLINK_ETH_EUR_FEED=0x...

# ─── External link base ───────────────────────────────────────────────────
# Used in NFT metadata's `external_url`.
# NEXT_PUBLIC_BASE_EXTERNAL_URL=https://ticketpulse.app/event/
